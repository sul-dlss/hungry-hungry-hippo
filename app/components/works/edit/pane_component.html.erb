<%# PaneComponent only accepts active_tab_name via attr_accessor, not as a constructor keyword, so it %>
<%# has to be built first and assigned afterward rather than passed in with label:/pane_args above. %>
<% pane = SdrViewComponents::TabForm::PaneComponent.new(label:, **pane_args) %>
<% pane.active_tab_name = active_tab_name %>
<%= render pane do |component| %>
  <%= content %>
  <% component.with_help do %>
    <%= help if help? %>
  <% end %>
  <% component.with_footer do %>
    <div class="d-flex justify-content-between">
      <div>
        <%= render Elements::CancelButtonComponent.new(link: cancel_path) %>
        <%= render Edit::TabForm::PreviousButtonComponent.new(tab_id:, classes: 'ms-2') if previous_tab_btn? %>
        <%= render Edit::TabForm::NextButtonComponent.new(tab_id:, classes: 'ms-2') if next_tab_btn? %>
        <% if deposit_button? %>
          <span class="ms-2">
            <%= deposit_button %>
          </span>
        <% end %>
      </div>
      <% if draft_btns? %>
        <div>
          <%= render Elements::Forms::SubmitComponent.new(form_id: form.id, label: 'Save as draft', variant: :'outline-primary', classes: 'me-2 disableable', data: { action: 'unsaved-changes#allowFormSubmission', controller: 'disableable' }) %>
          <%= render Edit::DiscardDraftSubmitButtonComponent.new(presenter: work_presenter, form_id: discard_draft_form_id, classes: 'disableable', data: { controller: 'disableable' }) %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
