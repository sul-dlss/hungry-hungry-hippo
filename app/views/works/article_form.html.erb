<% content_for :content do %>
  <% form_id = dom_id(@work_form, 'tabbed_form') %>
  <% discard_draft_form_id = dom_id(@work_form, 'discard_form') %>
  <%= render Edit::DiscardDraftFormComponent.new(presenter: @work_presenter, id: discard_draft_form_id) if @work_presenter %>
  <% active_tab_name = params[:tab]&.to_sym || @active_tab_name || :files %>
  <%# The real form is rendered outside the TabListComponent, but will be referenced by input fields inside of it. %>
  <%= form_with(model: @work_form, id: form_id, html: { novalidate: true }) do |f| %>
    <% %i[lock version collection_druid content_id creation_date deposit_publication_date apo copyright form_id].each do |field| %>
      <%= f.hidden_field field %>
    <% end %>
  <% end %>
  <%= render Edit::TabForm::TabListComponent.new(data: { action: 'change->ahoy-form-changes#changed change->unsaved-changes#changed change->tab-error#changed' }) do |component| %>
    <% component.with_tab(label: t('work_form.panes.files.tab_label'), tab_name: :files, active_tab_name:, mark_required: true) %>
    <% component.with_tab(label: t('work_form.panes.title.tab_label'), tab_name: :title, active_tab_name:, mark_required: true) %>
    <% component.with_tab(label: t('work_form.panes.contributors.tab_label'), tab_name: :contributors, active_tab_name:, mark_required: true) %>
    <% component.with_tab(label: t('work_form.panes.abstract.tab_label'), tab_name: :abstract, active_tab_name:) %>
    <% component.with_tab(label: t('work_form.panes.types.tab_label'), tab_name: :types, active_tab_name:, mark_required: true) %>
    <% component.with_tab(label: t('work_form.panes.license.tab_label'), tab_name: :license, active_tab_name:, mark_required: true) %>
    <% component.with_tab(label: t('work_form.panes.dates.tab_label'), tab_name: :dates, active_tab_name:) %>
    <% component.with_tab(label: t('work_form.panes.related_content.tab_label'), tab_name: :related_content, active_tab_name:) %>
    <% component.with_tab(label: t('work_form.panes.citation.tab_label'), tab_name: :citation, active_tab_name:) %>
    <% component.with_tab(label: t('work_form.panes.deposit.tab_label'), tab_name: :deposit, active_tab_name:, mark_required: true) %>

    <%# This builder is used only to render pane content; TabListComponent will not render this as a form. %>
    <%# TabbedFormBuilder sets the `form` attribute on the fields it builds to the real form's id, so they %>
    <%# submit correctly even though they aren't necessarily nested inside it. %>
    <% form_with(model: @work_form, html: { id: form_id }, builder: Edit::TabForm::TabbedFormBuilder) do |form| %>
      <% component.with_pane do %>
        <%# This pane contains its own form for files. %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :files, label: t('work_form.panes.files.label'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, previous_tab_btn: false, mark_required: true) do %>
          <%= render Elements::Forms::InvalidFeedbackComponent.new(form:, field_name: :content) %>

          <%= render 'contents/edit', content: @content, form_id: @work_form.form_id %>

          <div id="content-files" class="pane-section">
            <%= turbo_frame_tag @content, 'show', src: content_path(@content), data: { controller: 'dropzone-files' }, class: 'dropzone-files' do %>
              <%= render SdrViewComponents::Elements::SpinnerComponent.new %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :title, label: t('work_form.panes.title.label'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, mark_required: true) do %>
          <%= render Works::Edit::TitleComponent.new(form:, work_form: @work_form, mark_contact_emails_required: false) %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :contributors, label: t('work_form.panes.contributors.label'), help_text: t('work_form.panes.contributors.help_text'), tooltip: t('work_form.panes.contributors.tooltip_html'),
                                                  form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, mark_required: true, pane_header_class: nil) do %>
          <%= render Works::Edit::ContributorsComponent.new(form:) %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :abstract, label: t('work_form.panes.abstract.label'), help_text: t('work_form.panes.abstract.help_text'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:) do %>
          <%= render Works::Edit::AbstractComponent.new(form:, mark_abstract_required: false, mark_keywords_required: false) %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :types, label: t('work_form.panes.types.label'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, mark_required: true) do %>
          <%= render Works::Edit::WorkTypeComponent.new(form:, collection: @collection) %>
          <%= render Works::Edit::VersionIdentificationComponent.new(form:) %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :license, label: t('work_form.panes.license.label'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, mark_required: true) do %>
          <%= render Works::Edit::LicenseComponent.new(form:, license_presenter: @license_presenter, license_help_url: Settings.article_license_url) %>
          <% unless @collection.no_custom_rights_statement_option? %>
            <%= render Works::Edit::TermsOfUseComponent.new(form:, collection: @collection) %>
          <% end %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :dates, label: t('work_form.panes.dates.label'), tooltip: t('work_form.panes.dates.tooltip_html'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:) do %>
          <%= render Works::Edit::DatesComponent.new(form:) %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :related_content, label: t('work_form.panes.related_content.label'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, pane_header_class: nil) do %>
          <%= render NestedComponentPresenter.for(form:, field_name: :related_works, model_class: RelatedWorkForm, form_component: RelatedWorks::EditComponent, fieldset_classes: 'pane-section') %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :citation, label: t('work_form.panes.citation.label'), tooltip: t('work_form.panes.citation.tooltip_html'), form:, discard_draft_form_id:, work_presenter: @work_presenter, help_text: t('work_form.panes.citation.help_text'), active_tab_name:) do %>
          <%= render Works::Edit::CitationComponent.new(form:) %>
        <% end %>
      <% end %>

      <% component.with_pane do %>
        <%= render Works::Edit::PaneComponent.new(tab_name: :deposit, label: t('work_form.panes.deposit.label'), form:, discard_draft_form_id:, work_presenter: @work_presenter, active_tab_name:, next_tab_btn: false, mark_required: true) do |pane_component| %>
          <% pane_component.with_help do %>
            <ul class="mb-0">
              <li>Be sure you have completed all the required sections.</li>
              <% if @work_form.agree_to_terms %><li>You have accepted the <a href="#" data-bs-toggle="modal" data-bs-target="#tod-modal">Terms of Deposit</a>.</li><% end %>
              <li>Your deposit may take several hours to complete if the total file size is larger than 10GB.</li>
            </ul>
          <% end %>

          <% if @work_presenter && !@work_presenter.first_draft? %>
            <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :info, text: t('work_form.panes.deposit.version_text')) %>
            <div class="pane-section">
              <%#
                When what's changing textarea is invalid and the user provides a value and then clicks Deposit / Save as draft,
                the change event is triggered first. The changes made to the DOM cause the form submit to be blocked.
                By calling tab-error#changed on the input event, the DOM is updated sooner than the change event,
                allowing the form to be submitted without blocking.
              %>
              <%= render Elements::Forms::TextareaFieldComponent.new(form:, field_name: :whats_changing, label: t('work_form.fields.whats_changing.label'), tooltip: t('work_form.fields.whats_changing.tooltip_html'), maxlength: 100, data: { action: 'input->tab-error#changed' }) %>
            </div>
          <% else %>
            <%# This is a dummy value that is needed for validation, but won't be used for the version description. %>
            <%= form.hidden_field :whats_changing, value: 'Initial version' %>
          <% end %>
          <%= render Works::Edit::TermsOfDepositComponent.new(form:) %>
          <% pane_component.with_deposit_button do %>
            <%= render Works::Edit::SubmitComponent.new(work: @work, collection: @collection, form:, data: { action: 'unsaved-changes#allowFormSubmission' }) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<%= render template: 'works/form_layout' %>
